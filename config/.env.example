# Affiliate Finder Bot - Multi-platform Product Search
# Shopee Affiliate + TikTok Shop Affiliate

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef
TELEGRAM_ADMIN_IDS=123456789  # comma-separated user IDs, e.g. 123456789,987654321

# ===== Database =====
DB_PATH=affiliate_finder.db

# ===== Shopee Affiliate API =====
# Dapatkan dari: https://openplatform.shopee.com/ (Affiliate Program)
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_API_BASE=https://openplatform.shopee.com
SHOPEE_PARTNER_ID=  # optional, untuk tracking

# ===== TikTok Shop Affiliate API =====
# Dapatkan dari: https://affiliate.tiktokglobalshop.com/ (Affiliate Center)
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_CIPHER=  # optional, untuk encrypt

# ===== Optional: Proxy / Rate Limit =====
HTTP_PROXY=  # e.g. http://user:pass@host:port
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=60

# ===== Bot Settings =====
DEFAULT_MAX_RESULTS=10
DEFAULT_MIN_COMMISSION_RATE=1.0  # percentage
CACHE_TTL_SECONDS=300